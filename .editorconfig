root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

# Windows PowerShell 5.1 needs a BOM to read non-ASCII characters correctly.
[*.{ps1,psm1,psd1}]
charset = utf-8-bom

# cmd.exe reads batch files in the OEM code page: keep them pure ASCII.
[*.{bat,cmd}]
charset = latin1

[*.{json,yml,yaml,toml}]
indent_size = 2

[*.{yml,yaml,toml}]
end_of_line = lf

[*.md]
trim_trailing_whitespace = false
